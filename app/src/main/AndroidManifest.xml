<?xml version="1.0" encoding="utf-8"?>
<!--
  Screen Translator — V1 (Mobile / Android)
  Permissions are minimal on purpose: no camera, no microphone, no location,
  no contacts. Screen capture is the whole point of the app and is always
  user-initiated (MediaProjection consent dialog every session).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground service for screen capture + overlay. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+: media-projection foreground service type needs its own permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Draw the floating bubble + translated bubbles over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Foreground-service notification (API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Model downloads + LibreTranslate. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenTranslator">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ScreenTranslator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Single foreground service: owns MediaProjection capture, the
          translation pipeline, the floating bubble and the overlay windows.
          One service = one notification = one FGS type to get right.
          foregroundServiceType="mediaProjection" is required on API 34+
          for any service that holds a MediaProjection.
        -->
        <service
            android:name=".capture.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
